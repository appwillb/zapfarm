# Porta da aplicacao (Coolify injeta a dele; padrao local: 3001)
PORT=3001
NODE_ENV=development

# Diretorio de dados e banco SQLite
DATA_DIR=./data
DATABASE_PATH=./data/zapfarm.db

# Segredo JWT - OBRIGATORIO em producao (minimo 32 caracteres).
# Gere um forte com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=troque_por_um_segredo_forte_de_no_minimo_32_caracteres

# Integracao Rota88 - configure no painel do Coolify.
# SEM esta chave, o despacho de entregas no Rota88 fica desabilitado (erro explicito).
ROTA88_API_URL=https://api.rota88.org
ROTA88_API_KEY=
ROTA88_CONSOLE_URL=https://painel.rota88.org

# Tempo (minutos) para expirar pedidos Pix nao pagos e devolver o estoque reservado
PIX_EXPIRATION_MINUTES=60

# Origem externa permitida em CORS (opcional; em producao mesma-origem nao precisa)
# CORS_ORIGIN=https://app.seudominio.com.br

# Diretorio de uploads de midia (opcional; padrao: DATA_DIR/uploads)
# UPLOADS_DIR=./data/uploads
